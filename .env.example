# Variables d'environnement de Typio. Copier ce fichier en `.env.local` (jamais commité :
# `.gitignore` exclut `.env*` sauf `.env.example`) et renseigner les valeurs. Ne JAMAIS écrire
# de secret dans ce fichier-ci.

# --- Base de données -------------------------------------------------------------------
# PostgreSQL local de développement, par exemple :
#   postgresql://typio:typio@localhost:5433/typio
DATABASE_URL=

# --- Connexion GitHub et Discord (AUTH-2, AUTH-3) ---------------------------------------
# Les boutons « GitHub » et « Discord » ne s'activent que si le fournisseur est complet :
# identifiant, secret ET APP_ORIGIN renseignés. Sinon le bouton reste désactivé (« bientôt »).
# Ne demander aucun scope supplémentaire : GitHub = profil public seulement, Discord = `identify`.
# Typio ne stocke que l'identifiant numérique du compte (jamais e-mail, avatar ni jeton).

# Origine publique du site, sans chemin ni barre finale. Sert à construire les adresses de
# retour ci-dessous ; n'est JAMAIS déduite de l'en-tête Host.
#   développement : http://localhost:3000
#   production    : https://typio.aether-manager.ca
APP_ORIGIN=

# GitHub : https://github.com/settings/developers > OAuth Apps > New OAuth App
#   Authorization callback URL : ${APP_ORIGIN}/api/auth/github/callback
#   (une application distincte pour le développement et la production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord : https://discord.com/developers/applications > New Application > OAuth2
#   Redirects : ${APP_ORIGIN}/api/auth/discord/callback
#   Client secret : bouton « Reset Secret » de la même page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
