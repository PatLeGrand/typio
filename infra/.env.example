# Copier ce fichier vers infra/.env uniquement sur le VPS.
# Utiliser le même mot de passe lors de la création du rôle PostgreSQL typio.
MDP_TYPIO=

# Connexion GitHub et Discord : valeurs des applications OAuth de PRODUCTION.
# URL de retour à déclarer chez chaque fournisseur :
#   https://typio.aether-manager.ca/api/auth/github/callback
#   https://typio.aether-manager.ca/api/auth/discord/callback
# Laisser vide pour garder le bouton désactivé. Ne jamais commiter ce fichier rempli.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
